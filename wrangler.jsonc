// Cloudflare settings for the live site. The build (nitro) merges this into
// .output/server/wrangler.json, adding the entry file and the static files itself.
// Secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, ADMIN_EMAILS, ADMIN_SESSION_SECRET) are set
// in the Cloudflare dashboard, never here; for a local test run they go in .dev.vars
// (git-ignored).
{
  "name": "mirav-hafakot-site",
  // Merav's Cloudflare account (not a secret).
  "account_id": "c87a3721d95567fea83b73bd7a9abd02",
  // Fixed, so a build on another day runs on the same Workers behaviour; raise it deliberately.
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The site lives only on hafakathamerav.co.il (the custom domain, also listed here so a deploy keeps it; www
  // redirects there by a Cloudflare rule). No extra workers.dev or preview addresses: Google
  // sign-in is registered only on the domain, and previews would share the live storage.
  "routes": [{ "pattern": "hafakathamerav.co.il", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Saved content and added admins (created 2026-11-23 in Merav's account, region EEUR).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mirav-content",
      "database_id": "2f938919-6662-43e9-bf15-e1cb2dd50d65",
      "migrations_dir": "migrations",
    },
  ],
  // Photos and videos uploaded in the admin, served at /uploads/<name>.
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "mirav-uploads" }],
}
